<body>

<div class="app">
  <div class="sidebar">
    <div class="sidebar-header">
      <h1>The Civis Project</h1>
      <a class="back" href="index.html">← Back to map</a>
    </div>
    <div class="sidebar-tools">
      <input type="text" id="searchCountries" placeholder="Search countries..." oninput="renderList()">
      <div class="btn-row">
        <button class="btn" onclick="addCountry()">+ Add country</button>
      </div>
      <div class="btn-row">
        <button class="btn" onclick="exportData()">Export JSON</button>
        <button class="btn" onclick="document.getElementById('importFile').click()">Import JSON</button>
        <input type="file" id="importFile" accept=".json" style="display:none" onchange="importData(event)">
      </div>
    </div>
    <div class="country-list" id="countryList"></div>
  </div>

  <div class="main" id="main">
    <div class="empty-state">Select a country from the list, or add a new one, to start editing.</div>
  </div>
</div>

<script>
const tierColor = {Strong:"#639922", Stable:"#1D9E75", Strained:"#EF9F27", Critical:"#E24B4A"};

const defaultData = {
  "Norway": {edu:91, health:94, econ:78, safety:82},
  "Japan": {edu:95, health:96, econ:74, safety:88},
  "Canada": {edu:88, health:90, econ:76, safety:79},
  "Australia": {edu:87, health:90, econ:75, safety:78},
  "Germany": {edu:85, health:89, econ:73, safety:80},
  "South Korea": {edu:93, health:91, econ:62, safety:74},
  "Poland": {edu:80, health:82, econ:64, safety:69},
  "Chile": {edu:74, health:80, econ:58, safety:60},
  "United States of America": {edu:78, health:72, econ:66, safety:52},
  "Mexico": {edu:64, health:68, econ:52, safety:44},
  "Brazil": {edu:62, health:66, econ:48, safety:40},
  "Indonesia": {edu:60, health:63, econ:50, safety:44},
  "South Africa": {edu:55, health:58, econ:38, safety:41},
  "India": {edu:52, health:57, econ:44, safety:39},
  "Egypt": {edu:50, health:60, econ:41, safety:38},
  "Ethiopia": {edu:40, health:37, econ:28, safety:27},
  "Nigeria": {edu:35, health:38, econ:26, safety:24},
  "Haiti": {edu:28, health:30, econ:15, safety:12},
  "Yemen": {edu:18, health:22, econ:9, safety:6},
  "Afghanistan": {edu:15, health:20, econ:8, safety:5}
};

const STORAGE_KEY = 'civisProjectData';
let overrides = {};
let activeCountry = null;

function loadOverrides() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    overrides = raw ? JSON.parse(raw) : {};
  } catch (e) { overrides = {}; }
}

function saveOverrides() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(overrides));
}

function allCountryNames() {
  const names = new Set([...Object.keys(defaultData), ...Object.keys(overrides)]);
  return Array.from(names).sort();
}

function getCountryData(name) {
  const base = defaultData[name] || { edu: 50, health: 50, econ: 50, safety: 50 };
  return Object.assign({}, base, overrides[name] || {});
}

function computeTier(score) {
  if (score >= 75) return 'Strong';
  if (score >= 60) return 'Stable';
  if (score >= 40) return 'Strained';
  return 'Critical';
}

function computeScore(d) {
  return Math.round((d.edu + d.health + d.econ + d.safety) / 4);
}

/* ---------- Sidebar list ---------- */
function renderList() {
  const q = document.getElementById('searchCountries').value.trim().toLowerCase();
  const list = document.getElementById('countryList');
  const names = allCountryNames().filter(n => n.toLowerCase().includes(q));
  list.innerHTML = names.map(name => {
    const d = getCountryData(name);
    const score = computeScore(d);
    const tier = computeTier(score);
    const isEdited = !!overrides[name];
    return `
      <div class="country-item ${name === activeCountry ? 'active' : ''}" onclick="selectCountry('${name.replace(/'/g, "\\'")}')">
        <span class="dot" style="background:${tierColor[tier]}"></span>
        <span class="name">${name}</span>
        <span class="score">${score}</span>
        ${isEdited ? '<span class="edited-badge">edited</span>' : ''}
      </div>
    `;
  }).join('');
}

function addCountry() {
  const name = prompt('Country name (should match its name on the world map, e.g. "Vietnam"):');
  if (!name || !name.trim()) return;
  const trimmed = name.trim();
  if (!overrides[trimmed] && !defaultData[trimmed]) {
    overrides[trimmed] = { edu: 50, health: 50, econ: 50, safety: 50, article: '' };
    saveOverrides();
  }
  renderList();
  selectCountry(trimmed);
}

/* ---------- Main editing panel ---------- */
function selectCountry(name) {
  activeCountry = name;
  renderList();
  const d = getCountryData(name);
  const score = computeScore(d);
  const tier = computeTier(score);
  const main = document.getElementById('main');

  main.innerHTML = `
    <div class="panel-header">
      <div>
        <h2>${name}</h2>
        <span class="tier-badge" style="background:${tierColor[tier]}22; color:${tierColor[tier]}">${tier} · ${score}/100</span>
      </div>
      <button class="btn danger" onclick="deleteOverride('${name.replace(/'/g, "\\'")}')">Revert to default</button>
    </div>

    <div class="field-group">
      <h3>Indicator scores</h3>
      <div class="score-grid">
        ${scoreField('edu', 'Education', d.edu)}
        ${scoreField('health', 'Health', d.health)}
        ${scoreField('econ', 'Economic opportunity', d.econ)}
        ${scoreField('safety', 'Safety', d.safety)}
      </div>
      <div class="composite-row">
        <div class="composite-score" id="compositeScore">${score}</div>
        <div>
          <div class="composite-label">Composite score (average of the four, auto-calculated)</div>
          <div class="composite-label" id="compositeTier" style="color:${tierColor[tier]}">${tier}</div>
        </div>
      </div>
    </div>

    <div class="field-group">
      <h3>Country brief</h3>
      <div class="toolbar">
        <button onclick="fmt('bold')" title="Bold"><b>B</b></button>
        <button onclick="fmt('italic')" title="Italic"><i>I</i></button>
        <button onclick="fmt('formatBlock','H2')" title="Heading">H2</button>
        <button onclick="fmt('insertUnorderedList')" title="Bullet list">•—</button>
        <button onclick="fmt('insertOrderedList')" title="Numbered list">1.</button>
        <button onclick="makeLink()" title="Link">🔗</button>
        <button onclick="fmt('removeFormat')" title="Clear formatting">✕</button>
      </div>
      <div id="articleEditor" contenteditable="true">${d.article || ''}</div>
      <div class="hint">This shows up as a "Country brief" section when someone clicks ${name} on the map.</div>
    </div>

    <div class="save-bar">
      <button class="btn primary" onclick="saveCountry('${name.replace(/'/g, "\\'")}')">Save changes</button>
      <span class="toast" id="toast">Saved ✓</span>
    </div>
  `;
}

function scoreField(key, label, value) {
  return `
    <div class="score-field">
      <label>${label}</label>
      <input type="range" min="0" max="100" value="${value}" id="field-${key}" oninput="onScoreChange()">
      <div class="val" id="val-${key}">${value}</div>
    </div>
  `;
}

function onScoreChange() {
  const edu = parseInt(document.getElementById('field-edu').value, 10);
  const health = parseInt(document.getElementById('field-health').value, 10);
  const econ = parseInt(document.getElementById('field-econ').value, 10);
  const safety = parseInt(document.getElementById('field-safety').value, 10);
  document.getElementById('val-edu').textContent = edu;
  document.getElementById('val-health').textContent = health;
  document.getElementById('val-econ').textContent = econ;
  document.getElementById('val-safety').textContent = safety;
  const score = computeScore({ edu, health, econ, safety });
  const tier = computeTier(score);
  document.getElementById('compositeScore').textContent = score;
  document.getElementById('compositeScore').style.color = tierColor[tier];
  const tierEl = document.getElementById('compositeTier');
  tierEl.textContent = tier;
  tierEl.style.color = tierColor[tier];
}

function fmt(command, value) {
  document.getElementById('articleEditor').focus();
  document.execCommand(command, false, value || null);
}

function makeLink() {
  const url = prompt('Link URL:');
  if (url) fmt('createLink', url);
}

function saveCountry(name) {
  const edu = parseInt(document.getElementById('field-edu').value, 10);
  const health = parseInt(document.getElementById('field-health').value, 10);
  const econ = parseInt(document.getElementById('field-econ').value, 10);
  const safety = parseInt(document.getElementById('field-safety').value, 10);
  const article = document.getElementById('articleEditor').innerHTML;
  const score = computeScore({ edu, health, econ, safety });
  const tier = computeTier(score);

  overrides[name] = { edu, health, econ, safety, score, tier, article };
  saveOverrides();
  renderList();

  const toast = document.getElementById('toast');
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 1800);
}

function deleteOverride(name) {
  if (!confirm(`Revert "${name}" to its default values and clear its article? This can't be undone.`)) return;
  delete overrides[name];
  saveOverrides();
  if (defaultData[name]) {
    selectCountry(name);
  } else {
    activeCountry = null;
    document.getElementById('main').innerHTML = '<div class="empty-state">Select a country from the list, or add a new one, to start editing.</div>';
  }
  renderList();
}

/* ---------- Export / Import ---------- */
function exportData() {
  const blob = new Blob([JSON.stringify(overrides, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'civis-project-data.json';
  a.click();
  URL.revokeObjectURL(url);
}

function importData(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = (e) => {
    try {
      const parsed = JSON.parse(e.target.result);
      overrides = Object.assign({}, overrides, parsed);
      saveOverrides();
      renderList();
      alert('Import successful.');
    } catch (err) {
      alert('That file could not be read as valid JSON.');
    }
  };
  reader.readAsText(file);
  event.target.value = '';
}

loadOverrides();
renderList();
</script>
</body>
</html>
